diff --git a/Firmware/communication/can/can_simple.cpp b/Firmware/communication/can/can_simple.cpp
index 988c3c4..5e5202f 100644
--- a/Firmware/communication/can/can_simple.cpp
+++ b/Firmware/communication/can/can_simple.cpp
@@ -158,6 +158,9 @@ void CANSimple::do_command(Axis& axis, const can_Message_t& msg) {
         case MSG_GET_CONTROLLER_ERROR:
             get_controller_error_callback(axis);
             break;
+        case MSG_GET_DRV_FAULT:
+            if (msg.rtr || msg.len == 0) get_drv_fault_callback(axis);
+            break;
         default:
             break;
     }
@@ -219,6 +222,19 @@ bool CANSimple::get_controller_error_callback(const Axis& axis) {
     return canbus_->send_message(txmsg);
 }
 
+bool CANSimple::get_drv_fault_callback(const Axis& axis) {
+    can_Message_t txmsg;
+    txmsg.id = axis.config_.can.node_id << NUM_CMD_ID_BITS;
+    txmsg.id += MSG_GET_DRV_FAULT;
+    txmsg.isExt = axis.config_.can.is_extended;
+    txmsg.len = 8;
+
+    can_setSignal(txmsg, axis.last_drv_fault_, 0, 32, true);
+    can_setSignal(txmsg, axis.motor_.fet_thermistor_.temperature_, 32, 32, true);
+
+    return canbus_->send_message(txmsg);
+}
+
 void CANSimple::set_axis_nodeid_callback(Axis& axis, const can_Message_t& msg) {
     axis.config_.can.node_id = can_getSignal<uint32_t>(msg, 0, 32, true);
 }
