[Unit]
Description=Quassel UGV Sensor Hub (RTK-GPS + WitMotion IMU + CAN)
Wants=network-online.target slcan-can0.service
After=network-online.target slcan-can0.service

[Service]
Type=simple
User=imperator
Group=imperator
SupplementaryGroups=dialout
WorkingDirectory=/opt/sensor_hub
Environment=PYTHONUNBUFFERED=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStartPre=/usr/local/bin/wait-can0.sh
ExecStart=/usr/bin/python3 /opt/sensor_hub/sensor_hub_app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
