# USB-Gadget-Link (CDC-ECM) auf dem Orange Pi Zero 2W: usb0 mit 10.66.0.1/24.
# Installation auf dem Orange Pi:
#   sudo install -m 755 /opt/sensor_hub/scripts/usb_gadget_setup.sh /usr/local/bin/usb_gadget_setup.sh
#   sudo install -m 644 /opt/sensor_hub/scripts/usb-gadget.service /etc/systemd/system/usb-gadget.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now usb-gadget.service
[Unit]
Description=Sensor Hub USB-Gadget (CDC-ECM usb0, 10.66.0.1/24)
After=sys-kernel-config.mount
Before=sensor-hub.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/usb_gadget_setup.sh
ExecStop=/usr/local/bin/usb_gadget_setup.sh stop

[Install]
WantedBy=multi-user.target
