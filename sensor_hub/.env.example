GPS_PORT=/dev/serial/by-id/usb-FTDI_FT231X_USB_UART_*
GPS_BAUDRATE=230400

IMU_ENABLED=1
IMU_TYPE=witmotion
IMU_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
IMU_BAUDRATE=9600

WEB_HOST=0.0.0.0
WEB_PORT=80

# Zugangsschutz des Webservers. Der SensorHub haengt ueber eine Portfreigabe am
# Internet und liefert die metergenaue Position des Fahrzeugs.
# WEB_AUTH_PASSWORD akzeptiert Klartext oder einen Werkzeug-Hash (pbkdf2:.../scrypt:...).
# Ohne gesetztes Passwort antwortet der Server auf jede Anfrage mit 503.
# Derselbe Wert gehoert auf dem Raspberry in SENSOR_HUB_TELEMETRY_PASSWORD,
# sonst bleibt die Pose aus und der Fahrantrieb pausiert.
WEB_AUTH_ENABLED=1
WEB_AUTH_USERNAME=ugv
WEB_AUTH_PASSWORD=your-web-password

CAN_ENABLED=0
CAN_INTERFACE=can0
CAN_BITRATE=250000

NTRIP_ENABLED=1
NTRIP_HOST=openrtk-mv.de
NTRIP_PORT=2101
# openrtk_mv liefert MSM4 mit GPS+GLONASS+Galileo+BeiDou (MT1074/1084/1094/1124).
# Nicht openrtk_mv_2G verwenden: nur Legacy-RTCM3 mit GPS+GLONASS (MT1004/1012),
# ohne Galileo und BeiDou - deutlich schwaechere Fix-Stabilitaet.
# Der Account erlaubt nur EINE gleichzeitige Verbindung. Siehe SETUP_NTRIP.md.
NTRIP_MOUNTPOINT=openrtk_mv
NTRIP_USERNAME=your-username
NTRIP_PASSWORD=your-password
# Kommen so viele Sekunden lang keine RTCM-Daten, obwohl der Socket verbunden
# ist, wird die Verbindung als tot behandelt und neu aufgebaut. Faengt den Fall
# ab, dass der Caster den Socket offen laesst, aber nichts mehr sendet - sonst
# haengt RTK bis zum serverseitigen Timeout (~7 min) auf GPS FIX. 0 schaltet ab.
NTRIP_STALE_TIMEOUT=10.0
