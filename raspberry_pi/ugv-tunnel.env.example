# Ziel des Rueckwaertstunnels. Gehoert nach /etc/ugv-tunnel.env, Modus 600.
#
# Diese Datei ist eine Vorlage und enthaelt keine echten Werte. Die echte Datei
# bleibt auf dem Geraet - sie benennt einen Rechner und einen Benutzer im
# fremden Netz und hat im Repository nichts verloren.

# Erreichbarkeit des Zielrechners aus dem Internet. Der Name muss auch dann
# stimmen, wenn das Fahrzeug am Mobilfunkrouter haengt - eine LAN-Adresse
# taugt hier also nicht.
TUNNEL_HOST=schloss.example.de
TUNNEL_PORT=22
TUNNEL_USER=ugvtunnel

# Ports auf der Gegenseite, jeweils an 127.0.0.1 gebunden. Der Webport wird
# dort vom Reverse Proxy per HTTPS veroeffentlicht, der SSH-Port bleibt fuer
# die Wartung und wird ueber den Zielrechner gesprungen.
TUNNEL_WEB_PORT=18080
TUNNEL_SSH_PORT=12222
