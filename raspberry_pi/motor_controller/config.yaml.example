# Quassel UGV Motor Controller - Konfiguration
# Version 2.0

# PWM-Konfiguration (Motor-Steuerung)
pwm:
  enabled: true
  pins:
    left: 19    # GPIO19 für linken Motor
    right: 18   # GPIO18 für rechten Motor
  frequency: 50  # Hz
  neutral_value: 1500  # μs (Neutral-Position)
  min_value: 1000      # μs (Minimum)
  max_value: 2000      # μs (Maximum)
  forward_factor: 500.0   # Vorwärts/Rückwärts-Faktor
  turn_factor: 300.0      # Dreh-Faktor

# Ramping-Konfiguration (Sanfte Beschleunigung/Bremsung)
ramping:
  enabled: true
  acceleration_rate: 25    # μs/s (Beschleunigung)
  deceleration_rate: 800   # μs/s (Verzögerung)
  brake_rate: 1500         # μs/s (Bremsen zu Neutral)
  update_interval: 0.02    # Sekunden (50Hz)

# Sicherheits-Konfiguration
safety:
  pin: 17                  # GPIO17 für Sicherheitsschalter, falls verbaut
  enabled: false            # true nur setzen, wenn ein Schalter an diesem Pin existiert
  debounce_time: 0.2       # Sekunden
  command_timeout: 2.0     # Sekunden (CAN-Command-Timeout)
  joystick_timeout: 1.0    # Sekunden (Joystick-Timeout)
  can_watchdog_enabled: true       # Gesamtsystem stoppen, wenn CAN-Teilnehmer ausfallen
  can_watchdog_startup_grace_s: 5.0
  can_watchdog_interval_s: 0.1

# Licht-Konfiguration
light:
  enabled: true
  pin: 22                  # GPIO22 für Licht-Relais

# Mäher-Konfiguration
mower:
  enabled: false           # Haupt-UGV: Mähdeck wird ausschließlich per ODrive-USB gesteuert
  relay_pin: 23            # GPIO23 für Mäher-Relais
  pwm_pin: 12              # GPIO12 für Mäher-PWM
  pwm_frequency: 1000      # Hz
  duty_min: 16             # % (Minimale Geschwindigkeit)
  duty_max: 84             # % (Maximale Geschwindigkeit)
  duty_off: 0              # % (Aus)

odrive_mower:
  enabled: true
  transport: usb           # Haupt-UGV: zwei direkte ODrive-USB-Verbindungen
  node_id: 0               # Rueckfall fuer Einzelmotor-Betrieb
  node_ids: [0, 1, 2]      # Drei angeschlossene Mähmotor-Nodes; Node 3 ist unbenutzt
  usb_axes:
    - {node_id: 0, serial_number: "386132523135", axis: 0}
    - {node_id: 1, serial_number: "386132523135", axis: 1}
    - {node_id: 2, serial_number: "387132523135", axis: 0}
  usb_connect_timeout_s: 5.0
  usb_reconnect_interval_s: 1.0
  usb_idle_poll_interval_s: 0.5 # Im Stillstand geringe Fibre-Last
  usb_startup_hang_timeout_s: 8.0 # Festhängenden nativen USB-Aufruf hart abbrechen
  axis_state: 5            # Legacy sensorless state
  min_rpm: 500             # Sensorless-Teststand: darunter unzuverlaessig
  max_rpm: 5000
  default_rpm: 500
  ramp_rate_rpm_s: 300
  command_interval_s: 0.1  # Set_Input_Vel periodisch senden
  coast_delay_s: 0.5
  start_stagger_s: 0.3     # Mehrere Mäher-Nodes nacheinander starten
  sequential_start_enabled: true
  startup_timeout_s: 2.5
  startup_retries: 1
  startup_current_limit_a: 12.0
  startup_abort_current_a: 12.5
  startup_min_sensorless_rpm: 120.0
  startup_stable_duration_s: 0.4
  operating_current_limit_a: 30.0
  heartbeat_timeout_s: 1.0        # Gemeinsame Zustands-Altersgrenze der Transportabstraktion
  usb_status_timeout_s: 3.0       # Host-Status; ODrive-Hardware-Watchdog bleibt 1.0 s
  current_monitor_enabled: true
  current_poll_interval_s: 0.1     # Kommandozyklus; GET_IQ läuft Round-Robin je Node
  current_poll_while_idle: false   # Erst mit konfiguriertem Hardware-Watchdog aktivieren
  current_response_timeout_s: 10.0 # Kurze USB-Abfragelücken tolerieren; danach Gesamtsystem stoppen
  current_startup_grace_s: 2.0     # Sensorless-Anlauf nicht als Blockade werten
  current_trip_a: 25.0             # Unterhalb des ODrive-Hardlimits von 30 A
  current_trip_duration_s: 0.5
  current_critical_trip_a: 29.0    # Nahe Hardlimit: praktisch sofort stoppen
  current_critical_trip_duration_s: 0.1
  # Ein libfibre-Aufruf blockiert seinen Thread ohne Timeout. Beide Grenzen
  # werden vom zentralen Safety-Watchdog geprueft, der den Transport selbst
  # nie anfasst und deshalb nicht mit haengen bleiben kann.
  command_loop_timeout_s: 3.0      # Kommando-Thread ohne Lebenszeichen -> Stopp
  usb_call_stall_timeout_s: 5.0    # Endgueltig haengender Aufruf -> Prozessneustart
  # Messerdrehzahl wird nicht nur beim Anlauf, sondern im ganzen Lauf geprueft.
  runtime_rpm_monitor_enabled: true
  runtime_sensorless_poll_interval_s: 0.5
  runtime_sensorless_timeout_s: 3.0
  runtime_min_rpm: 150.0           # Nur "dreht ueberhaupt", nicht Solldrehzahl
  runtime_rpm_fault_duration_s: 1.5

# Junctek KG110F Coulombzaehler ueber Bluetooth LE.
# Der Zaehler sendet von sich aus etwa einmal pro Sekunde; es wird nur
# zugehoert, nie geschrieben. Damit bleibt der gemeinsame Funkchip des Pi 3
# fuer den SensorHub-Pose-Stream frei.
battery:
  enabled: false
  address: ''                # BLE-MAC, z.B. E4:66:E5:60:FB:1C
  capacity_ah: 50.0          # Muss dem AH.Preset am Geraet entsprechen
  warn_percent: 30.0         # Nur Warnung im Web-UI
  mow_stop_percent: 25.0     # Maehdeck aus - der groesste Verbraucher zuerst
  drive_stop_percent: 20.0   # Fahrt beenden
  # Ein Ladezustand bewegt sich ueber Minuten. Ein kurzer Funkausfall darf
  # den Wert deshalb nicht verwerfen und schon gar nicht das Fahrzeug stoppen.
  stale_timeout_s: 120.0

# Classical-CAN-2.0-Konfiguration; CAN FD wird nicht verwendet.
# Haupt-UGV und ehemaliger UGV-Teststand: einheitlich 250 kbit/s.
can:
  enabled: false           # Haupt-UGV: SensorHub ueber WiFi, ODrives ueber USB
  interface: can0
  bitrate: 250000
  motor_controller_id: 0x200  # Eigene CAN-ID
  sensor_hub_id: 0x100        # Sensor Hub CAN-ID
  max_frame_size: 6           # Bytes Nutzdaten pro Frame
  frame_timeout: 1.0          # Sekunden

# SensorHub-Pose: "can" (legacy), "shadow" (WiFi nur vergleichen) oder
# "wifi" (WiFi ist aktive Quelle und wird vom Safety-Watchdog überwacht).
sensor_hub:
  transport: wifi          # Produktion: zwei persistente HTTP-Streams, kein CAN
  wifi_url: http://schloss.fdog.de:8081/api/telemetry
  # Zugangsdaten des SensorHub-Webservers. Das Passwort kommt aus der
  # Umgebungsvariable SENSOR_HUB_TELEMETRY_PASSWORD. Passt es nicht, bleibt die
  # Pose aus und der Watchdog pausiert nach ~1 s den Fahrantrieb.
  auth_username: ugv
  poll_interval_s: 0.2
  request_timeout_s: 1.5
  pause_timeout_s: 1.0
  telemetry_timeout_s: 30.0

# Navigation (S1 Bearing-Hold Wegpunkt-Controller)
# Pose kommt über den unter sensor_hub gewählten Transport.
navigation:
  enabled: true
  watchdog_timeout_s: 1.0      # Stop wenn keine aktuelle SensorHub-Pose >1s
  rtk_resume_stable_s: 2.0     # So lange muss RTK FIXED halten, bevor es weitergeht
  rtk_lost_timeout_s: 90.0     # Erst danach Plan-Abbruch; davor nur anhalten und warten
  geofence_radius_m: 50.0      # Um ersten Wegpunkt
  max_joystick: 0.45           # Max. 45% Joystick-Skala. Deckelt nicht nur die
                               # Fahrt: ueber die Innen-Rad-Garantie haengt auch
                               # der Lenkanteil daran. Bei 0.30 blieb er unter
                               # der Losbrechgrenze (Handtest 09.08.: 60 us kein
                               # Ausschlag, 150 us gerade eben nach links).
  turn_gain_left: 2.0          # Vorhalt fuer die Links/Rechts-Asymmetrie des
                               # Antriebs (gemessen 09.08.: rechts wirkt etwa
                               # doppelt so stark, 0.42 Grad/s Rechtszug bei
                               # neutralem Lenkbefehl). 1.0 = kein Vorhalt.
                               # Fahrzeugspezifisch - nach einer Reparatur am
                               # Antrieb neu bestimmen.
  acceptance_radius_m: 0.25    # Wegpunkt erreicht (Skid-Steer-Limit + RTK-Rauschen)
  slowdown_radius_m: 0.5       # Vor Ziel abbremsen, Throttle skaliert linear bis 0
  turn_kp: 0.02                # Joystick-X pro Grad Heading-Fehler
  track_lookahead_m: 0.8       # Pure-Pursuit Lookahead für Track-Polyline Testmodus
  pivot_heading_threshold_deg: 70.0 # Ab hier erst auf der Stelle ausrichten
  goto_divergence_limit_m: 0.75 # Goto stoppen, wenn die Distanz so weit wächst
  goto_divergence_samples: 5    # Anzahl aufeinanderfolgender Messungen
  track_cross_track_limit_m: 1.0 # Track stoppen, wenn Pfadabweichung größer ist
  track_alignment_enter_deg: 10.0 # Ab hier ohne Vorwaertsschub um ein stehendes
                               # Kettenpaar rollen statt gleichzeitig zu drehen und
                               # zu fahren (letzteres konvergiert real nicht, siehe
                               # track_heading_block_deg)
  track_alignment_exit_deg: 5.0   # Darunter normale Bahnverfolgung
  track_heading_block_deg: 45.0 # Ab hier ist selbst der Roll-Bogen nicht mehr
                               # sicher (urspruenglicher Brunnen-Stall: -51.7° bis
                               # -62.3°) - dort blockieren statt automatisch
                               # anzufahren. Gemessen gegen die Bahnrichtung,
                               # nicht gegen die Peilung zum Pure-Pursuit-Ziel.
  track_heading_block_samples: 3  # So viele Posen in Folge muss der Fehler
                                  # ueber der Sperre liegen. Danach wird nicht
                                  # abgebrochen, sondern rangiert.
  track_align_timeout_s: 10.0     # Ausrichtbogen ohne Winkelfortschritt stoppen.
  track_align_min_progress_deg: 0.5 # Im Bogen ruht der Track-Waechter (dort ist
                               # kein Bahnfortschritt gewollt); ohne diese
                               # Grenze rollte eine nicht konvergierende
                               # Ausrichtung unbegrenzt weiter - ohne Fehler.
                               # Fein genug, um langsame Konvergenz zuzulassen.
  track_align_escalate_s: 3.0  # Dreht der Kurs trotzdem nicht, laeuft der
                               # Drehanteil ueber diese Dauer bis max_joystick
                               # hoch und faellt zurueck, sobald er sich dreht.
  track_align_min_turn: 0.22   # Losbrechgrenze des Drehanteils im Bogen.
                               # Gemessen 07.08. auf Gras: x=0.236 dreht mit
                               # 1.3°/s, x=0.155 mit 0.4°/s, x=0.125 gar nicht.
                               # Proportional allein stirbt das Kommando aus,
                               # bevor track_alignment_exit_deg erreicht ist.
  track_stall_timeout_s: 10.0     # Stop bei ausbleibendem Track-Fortschritt
  track_stall_min_progress_m: 0.15 # Mindestfortschritt innerhalb des Zeitfensters
  min_inner_wheel_speed: 0.50  # Innen-Rad-Garantie: kurveninneres Rad rollt mind.
                               # mit 50% von max_joystick vorwärts (≈75 μs über Neutral,
                               # sicher außerhalb der ESC-Totzone). Anti-Pivot, schont Rasen.

# Drive-around Kartierung
mapping:
  enabled: true
  maps_dir: /home/nicolay/raspberrycan/maps  # GeoJSON FeatureCollections
  min_point_distance_m: 0.25        # Mindestabstand zwischen aufgezeichneten Punkten

# Web-Interface-Konfiguration
#
# Achtung: Dieses Interface ist über die Portfreigabe aus dem Internet
# erreichbar und kann Fahrantrieb und Mähdeck starten. Passwort und secret_key
# stehen NICHT hier, sondern in der Umgebung des Dienstes:
#
#   UGV_WEB_PASSWORD    Pflicht, solange auth_enabled true ist
#   UGV_WEB_SECRET_KEY  optional, sonst wird bei jedem Start einer erzeugt
#
# Siehe raspberry_pi/WEB_ZUGANGSSCHUTZ.md
web:
  enabled: true
  host: 0.0.0.0
  port: 80
  template_folder: templates
  static_folder: static
  max_speed_percent: 100.0
  auth_enabled: true       # false schaltet den Zugangsschutz ab (nur offline!)
  auth_username: ugv
  auth_realm: Quassel UGV
  allowed_origins: []      # zusätzliche Herkünfte für schreibende Requests
  auth_max_failures: 8     # danach sperrt die IP für auth_lockout_s
  auth_lockout_s: 60.0

# Push-Meldungen bei Stoerungen (ntfy)
#
# Bleibt das Fahrzeug wegen eines Fehlers stehen, faerbt die Oberflaeche das
# rot - aber nur, solange jemand hinsieht. Diese Meldungen gehen aufs Telefon.
#
# Topic und Token stehen NICHT hier, sondern in der Umgebung des Dienstes:
#
#   UGV_NTFY_TOPIC   Pflicht; bei ntfy.sh ist der Topic-Name das einzige
#                    Geheimnis - einen zufaelligen Namen waehlen, keinen
#                    ratbaren wie "ugv-fehler"
#   UGV_NTFY_TOKEN   optional, fuer ein geschuetztes oder eigenes ntfy
#   UGV_NTFY_SERVER  optional, ueberschreibt server
#
# Auf dem Telefon die ntfy-App installieren und dasselbe Topic abonnieren.
# Ein Testruf ohne echten Fehler:
#   curl -u ugv:PASSWORT -X POST http://<ugv>/api/notifications/test
notifications:
  enabled: false           # true schaltet die Meldungen ein
  server: https://ntfy.sh
  click_url: ''            # beim Antippen zu oeffnen, z.B. die Weboberflaeche
  request_timeout_s: 5.0
  min_interval_s: 120.0    # dieselbe Stoerung nicht oefter melden
  retry_max_age_s: 900.0   # so lange wird eine Meldung weiter versucht
  queue_size: 32
  fault_priority: 5        # ntfy 1-5; 5 klingelt auch im Stummmodus
  recovery_priority: 3
  notify_recovery: true    # Entwarnung, wenn die Fahrt weitergeht
  motion_hold_after_s: 20.0 # erst so lange Fahrpause gilt als Stoerung

# Logging-Konfiguration
logging:
  level: INFO              # DEBUG, INFO, WARNING, ERROR, CRITICAL
  format: '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
  file: /var/log/motor_controller.log
  console: true
  file_enabled: false

# Allgemeine Einstellungen
quiet: false
monitor: true
