# Quassel UGV Motor Controller - Konfiguration
# Version 2.0

# PWM-Konfiguration (Motor-Steuerung)
pwm:
  enabled: true
  pins:
    left: 19    # GPIO19 für linken Motor
    right: 18   # GPIO18 für rechten Motor
  frequency: 50  # Hz
  neutral_value: 1500  # μs (Neutral-Position)
  min_value: 1000      # μs (Minimum)
  max_value: 2000      # μs (Maximum)
  forward_factor: 500.0   # Vorwärts/Rückwärts-Faktor
  turn_factor: 300.0      # Dreh-Faktor

# Ramping-Konfiguration (Sanfte Beschleunigung/Bremsung)
ramping:
  enabled: true
  acceleration_rate: 25    # μs/s (Beschleunigung)
  deceleration_rate: 800   # μs/s (Verzögerung)
  brake_rate: 1500         # μs/s (Bremsen zu Neutral)
  update_interval: 0.02    # Sekunden (50Hz)

# Sicherheits-Konfiguration
safety:
  pin: 17                  # GPIO17 für Sicherheitsschalter
  enabled: true
  debounce_time: 0.2       # Sekunden
  command_timeout: 2.0     # Sekunden (CAN-Command-Timeout)
  joystick_timeout: 1.0    # Sekunden (Joystick-Timeout)
  can_watchdog_enabled: true       # Gesamtsystem stoppen, wenn CAN-Teilnehmer ausfallen
  can_watchdog_startup_grace_s: 5.0
  can_watchdog_interval_s: 0.1

# Licht-Konfiguration
light:
  enabled: true
  pin: 22                  # GPIO22 für Licht-Relais

# Mäher-Konfiguration
mower:
  enabled: false           # Haupt-UGV: Mähdeck wird ausschließlich per ODrive-CAN gesteuert
  relay_pin: 23            # GPIO23 für Mäher-Relais
  pwm_pin: 12              # GPIO12 für Mäher-PWM
  pwm_frequency: 1000      # Hz
  duty_min: 16             # % (Minimale Geschwindigkeit)
  duty_max: 84             # % (Maximale Geschwindigkeit)
  duty_off: 0              # % (Aus)

odrive_mower:
  enabled: true
  transport: usb           # Haupt-UGV: zwei direkte ODrive-USB-Verbindungen
  node_id: 0               # Rueckfall fuer Einzelmotor-Betrieb
  node_ids: [0, 1, 2]      # Drei angeschlossene Mähmotor-Nodes; Node 3 ist unbenutzt
  usb_axes:
    - {node_id: 0, serial_number: "386132523135", axis: 0}
    - {node_id: 1, serial_number: "386132523135", axis: 1}
    - {node_id: 2, serial_number: "387132523135", axis: 0}
  usb_connect_timeout_s: 5.0
  usb_reconnect_interval_s: 1.0
  usb_idle_poll_interval_s: 0.5 # Im Stillstand geringe Fibre-Last
  usb_startup_hang_timeout_s: 8.0 # Festhängenden nativen USB-Aufruf hart abbrechen
  axis_state: 5            # Legacy sensorless state
  min_rpm: 500             # Sensorless-Teststand: darunter unzuverlaessig
  max_rpm: 5000
  default_rpm: 500
  ramp_rate_rpm_s: 300
  command_interval_s: 0.1  # Set_Input_Vel periodisch senden
  coast_delay_s: 0.5
  start_stagger_s: 0.3     # Mehrere Mäher-Nodes nacheinander starten
  sequential_start_enabled: true
  startup_timeout_s: 2.5
  startup_retries: 1
  startup_current_limit_a: 12.0
  startup_abort_current_a: 12.5
  startup_min_sensorless_rpm: 120.0
  startup_stable_duration_s: 0.4
  operating_current_limit_a: 30.0
  heartbeat_timeout_s: 1.0        # CAN-Heartbeat; zugleich bisheriger Rückfallwert
  usb_status_timeout_s: 3.0       # Host-Status; ODrive-Hardware-Watchdog bleibt 1.0 s
  current_monitor_enabled: true
  current_poll_interval_s: 0.1     # Kommandozyklus; GET_IQ läuft Round-Robin je Node
  current_poll_while_idle: false   # Erst mit konfiguriertem Hardware-Watchdog aktivieren
  current_response_timeout_s: 10.0 # Kurze RTR-Lücken tolerieren; danach Gesamtsystem stoppen
  current_startup_grace_s: 2.0     # Sensorless-Anlauf nicht als Blockade werten
  current_trip_a: 25.0             # Unterhalb des ODrive-Hardlimits von 30 A
  current_trip_duration_s: 0.5
  current_critical_trip_a: 29.0    # Nahe Hardlimit: praktisch sofort stoppen
  current_critical_trip_duration_s: 0.1

# Classical-CAN-2.0-Konfiguration; CAN FD wird nicht verwendet.
# Haupt-UGV und ehemaliger UGV-Teststand: einheitlich 250 kbit/s.
can:
  enabled: false           # Haupt-UGV: SensorHub ueber WiFi, ODrives ueber USB
  interface: can0
  bitrate: 250000
  motor_controller_id: 0x200  # Eigene CAN-ID
  sensor_hub_id: 0x100        # Sensor Hub CAN-ID
  max_frame_size: 6           # Bytes Nutzdaten pro Frame
  frame_timeout: 1.0          # Sekunden

# SensorHub-Pose: "can" (legacy), "shadow" (WiFi nur vergleichen) oder
# "wifi" (WiFi ist aktive Quelle und wird vom Safety-Watchdog überwacht).
sensor_hub:
  transport: can
  wifi_url: http://192.168.178.20/api/telemetry
  poll_interval_s: 0.2
  request_timeout_s: 1.5
  pause_timeout_s: 1.0
  telemetry_timeout_s: 30.0

# Navigation (S1 Bearing-Hold Wegpunkt-Controller)
# Pose kommt über den unter sensor_hub gewählten Transport.
navigation:
  enabled: true
  watchdog_timeout_s: 1.0      # Stop wenn keine CAN-Pose >1s
  geofence_radius_m: 50.0      # Um ersten Wegpunkt
  max_joystick: 0.30           # Max. 30% Joystick-Skala
  acceptance_radius_m: 0.25    # Wegpunkt erreicht (Skid-Steer-Limit + RTK-Rauschen)
  slowdown_radius_m: 0.5       # Vor Ziel abbremsen, Throttle skaliert linear bis 0
  turn_kp: 0.02                # Joystick-X pro Grad Heading-Fehler
  track_lookahead_m: 0.8       # Pure-Pursuit Lookahead für Track-Polyline Testmodus
  pivot_heading_threshold_deg: 70.0 # Ab hier erst auf der Stelle ausrichten
  goto_divergence_limit_m: 0.75 # Goto stoppen, wenn die Distanz so weit wächst
  goto_divergence_samples: 5    # Anzahl aufeinanderfolgender Messungen
  track_cross_track_limit_m: 1.0 # Track stoppen, wenn Pfadabweichung größer ist
  min_inner_wheel_speed: 0.50  # Innen-Rad-Garantie: kurveninneres Rad rollt mind.
                               # mit 50% von max_joystick vorwärts (≈75 μs über Neutral,
                               # sicher außerhalb der ESC-Totzone). Anti-Pivot, schont Rasen.

# Drive-around Kartierung
mapping:
  enabled: true
  maps_dir: /home/nicolay/raspberrycan/maps  # GeoJSON FeatureCollections
  min_point_distance_m: 0.25        # Mindestabstand zwischen aufgezeichneten Punkten

# Web-Interface-Konfiguration
web:
  enabled: true
  host: 0.0.0.0
  port: 80
  secret_key: ugv_motor_controller_2024
  template_folder: templates
  static_folder: static
  max_speed_percent: 100.0

# Logging-Konfiguration
logging:
  level: INFO              # DEBUG, INFO, WARNING, ERROR, CRITICAL
  format: '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
  file: /var/log/motor_controller.log
  console: true
  file_enabled: false

# Allgemeine Einstellungen
quiet: false
monitor: true
